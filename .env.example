DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/jr_reformas?schema=public"

# Conexão direta (sem pooler), usada apenas por migrations e seed.
# No Neon, `neon deploy`/`neon env pull` preenche as duas: DATABASE_URL com o
# host `-pooler` (app) e DATABASE_URL_UNPOOLED sem pooler (migrations).
# Em Postgres local, deixe vazio para usar o DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Administrador criado por `npm run db:seed`. A senha só é aplicada na criação
# do usuário; depois disso, troque pelo painel em /admin/conta.
ADMIN_EMAIL="admin@jrsantana.com"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Segredo usado para assinar os JWTs de sessão e de redefinição de senha.
JWT_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres"

# URL pública da aplicação (usada nos links de e-mail e no metadata).
# Variável de servidor: não use o prefixo NEXT_PUBLIC_ em produção.
APP_URL="http://localhost:3000"

# Envio de e-mail via Resend. Sem a chave, o e-mail de recuperação NÃO é
# enviado e o erro aparece no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="JR Santana <onboarding@resend.dev>"

# Exibe o link de redefinição de senha na resposta da API (apenas para testes
# locais). Nunca habilite em produção.
EXPOSE_RESET_TOKEN="false"
