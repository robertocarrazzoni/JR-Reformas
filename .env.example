DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/jr_reformas?schema=public"

# Segredo usado para assinar os JWTs de sessão e de redefinição de senha.
JWT_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres"

# URL pública da aplicação (usada nos links de e-mail e no metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envio de e-mail via Resend. Sem a chave, o e-mail de recuperação NÃO é
# enviado e o erro aparece no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="JR Santana <onboarding@resend.dev>"

# Exibe o link de redefinição de senha na resposta da API (apenas para testes
# locais). Nunca habilite em produção.
EXPOSE_RESET_TOKEN="false"
