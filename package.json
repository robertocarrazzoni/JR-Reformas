{
  "name": "jr_reformas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "pretest": "docker compose up -d --wait postgres && npm run db:test:setup",
    "test": "jest",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:test:create": "node scripts/ensure-test-db.mjs",
    "db:test:migrate": "cross-env DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/jr_reformas_test?schema=public DATABASE_URL_UNPOOLED=postgresql://postgres:postgrespassword@localhost:5432/jr_reformas_test?schema=public prisma migrate deploy",
    "db:test:setup": "prisma generate && npm run db:test:create && npm run db:test:migrate"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.70.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jest": "^30.5.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
